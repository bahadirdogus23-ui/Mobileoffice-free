<?xml version="1.0" encoding="utf-8"?>
<!-- Files unpacked from an archive, handed to the viewers and to "Share"; photos the camera
     app takes for document scanning. -->
<paths>
    <cache-path name="archive" path="archive/" />
    <cache-path name="scan" path="scan/" />
    <!-- Screen pictures attached to problem reports. -->
    <cache-path name="reports" path="reports/" />
    <cache-path name="attachments" path="attachments/" />
    <!-- Documents found by walking shared storage that the system had not indexed (with "All
         files access"), shared from the home list. -->
    <external-path name="storage" path="." />
</paths>
